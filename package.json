{
  "name": "eosio-contract-api",
  "version": "1.3.24",
  "type": "module",
  "engines": {
    "node": ">=21"
  },
  "description": "EOSIO Contract API",
  "author": "pink.gg",
  "license": "AGPL-3.0",
  "repository": "https://github.com/pinknetworkx/eosio-contract-api",
  "scripts": {
    "clean": "node -e \"const fs=require('fs');for (const d of ['build','logs']){try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}fs.mkdirSync(d,{recursive:true})}\"",
    "lint": "eslint \"src/**/*.ts\"",
    "build": "yarn clean && tsc",
    "test": "vitest run",
    "postinstall": "yarn build",
    "start:server": "node ./build/bin/server.js",
    "start:filler": "node ./build/bin/filler.js",
    "start:abiscan": "node ./build/bin/abiscan.js",
    "dev:server": "tsc && node --trace-warnings ./build/bin/server.js",
    "dev:filler": "tsc && node --trace-warnings ./build/bin/filler.js",
    "dev:test:watch": "vitest",
    "dev:init-test-db": "tsc && node --trace-warnings ./build/bin/init-test-db.js"
  },
  "dependencies": {
    "async-exit-hook": "^2.0.1",
    "atomicassets": "^1.5.1",
    "await-lock": "^3.0.0",
    "body-parser": "^2.2.2",
    "common-tags": "^1.8.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "eosjs": "^22.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "ioredis": "^5.10.1",
    "micro-memoize": "^5.1.1",
    "node-worker-threads-pool": "^1.5.1",
    "p-queue": "^9.1.1",
    "pg": "^8.20.0",
    "pm2": "^6.0.14",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/common-tags": "^1.8.4",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "eslint": "^10.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}