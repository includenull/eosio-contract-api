{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "target": "ES2022",
    "rootDir": "./src",
    "outDir": "./build",
    "sourceMap": true,
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "src/utils/test.ts",
    "src/api/namespaces/atomicmarket/test.ts",
    "src/api/namespaces/atomicassets/test.ts"
  ]
}